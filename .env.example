# Slack bot token (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-your-app-token

# REQUIRED: comma-separated Slack user IDs allowed to drive agents and click approvals
ALLOWED_USER_IDS=U0123456789

# Channel → project/worktree mapping
PROJECTS_FILE=projects.json

# Agent process
CLAUDE_BIN=claude
# Extra CLI flags, e.g. "--model opus" or "--permission-mode acceptEdits"
CLAUDE_ARGS=
MAX_SESSIONS=10

# Virtual terminal size (a taller screen keeps more history in each Slack update)
PTY_COLS=100
PTY_ROWS=50
# How often the live Slack message is refreshed
FLUSH_INTERVAL=2s

DEBUG=false

# markdown (default): post Claude's replies as formatted Slack messages (tables, lists, code)
# screen: mirror the raw terminal screen (fallback / debugging)
OUTPUT_MODE=markdown

# Telegram (optional; Slack and Telegram can run together)
# Bot token from @BotFather. Deliberately not TELEGRAM_BOT_TOKEN, which other tools often export.
TELEGRAM_BRIDGE_BOT_TOKEN=
# Comma-separated Telegram user IDs (message your bot privately and it tells you your ID)
TELEGRAM_BRIDGE_ALLOWED_USER_IDS=
